# deck-to-video example environment — copy this file to `.env` and adjust.
# `.env` is git-ignored (git check-ignore .env); `.env.example` is the
# checked-in template for what the tool reads.

# ---------------------------------------------------------------------------
# OneVoice (default narration engine — Apple Silicon only)
# ---------------------------------------------------------------------------
# Voice used when a slide has no [voice: ...] tag. Defaults to the first
# available voice profile if unset.
ONE_VOICE=simone

# Optional: colon-separated list of voice-profile directories (leftmost wins).
# If unset, one_voice_adapter.py auto-configures ONE_VOICE_PATH on import:
#   this repo's voices/  +  the installed one-voice package's voices/
# ONE_VOICE_PATH=/absolute/path/to/voices_a:/absolute/path/to/voices_b

# ---
# Narration language (both engines: one-voice local TTS and --voicebox)
# ---
# Per-slide auto-detect is the default: slides with significant CJK content
# synthesize with lang_code="chinese" (one-voice) / language="zh" (Voicebox);
# English slides use "english" / "en". Verified: explicit "chinese" beats
# mlx-audio "auto" for Mandarin (宫保鸡丁 vs 公保鸡丁).
#   auto  — detect per slide (default when unset)
#   zh    — force Mandarin on every slide
#   en    — force English on every slide
# Also accepted as --language on the command line (flag wins over .env).
# DECK_LANGUAGE=auto

# ---
# Voicebox (fallback engine — only used with the --voicebox flag)
# ---
# Legacy Voicebox profile UUID (cloned voice). Required when --voicebox is used.
# VOICEBOX_PROFILE_ID=your-profile-uuid-goes-here

# Voicebox HTTP API base URL (default shown).
# VOICEBOX_API_URL=http://127.0.0.1:17493

# TTS engine used by Voicebox, overriding the profile's "Default Engine".
# Supported: qwen (Qwen3-TTS), qwen_custom_voice, luxtts, chatterbox,
#            chatterbox_turbo, tada, kokoro
# VOICEBOX_ENGINE=qwen

# Rewrite speaker notes in the profile's voice before TTS (= --personality)
# VOICEBOX_PERSONALITY=0